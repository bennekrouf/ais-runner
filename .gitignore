target
tmp_azurite_build/

# Build outputs that were committed by accident once — keep them out.
# bin/azurite is regenerated by scripts/package_azurite.sh and is only
# needed for `--features bundle-azurite`, which CI never enables.
bin/azurite
installer/dist/
/ais-runner

# Secrets / config
local.settings.json
# ...except the sample project's, which is a committed fixture: a test reads it,
# and tests/no_tenant_secrets.rs scans it on every run so it cannot quietly grow
# a real connection string the way it did between May and September 2026.
!test/logic-apps/local.settings.json
.env
.env.*

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Claude Code worktrees (ephemeral, never project files)
.claude/worktrees/

# WebView2 bootstrapper (downloaded by CI, not committed)
installer/MicrosoftEdgeWebview2Setup.exe
.claude/settings.local.json
