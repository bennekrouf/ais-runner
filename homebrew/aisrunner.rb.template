# Place this file at Formula/aisrunner.rb inside the homebrew-aisrunner repo.
# The release workflow auto-updates version + sha256 on every tagged release.
# Users install with:
#   brew tap Bennekrouf/aisrunner
#   brew install aisrunner

class Aisrunner < Formula
  desc "AIS Local Runner — desktop runner for Azure-backed AI services"
  homepage "https://github.com/Bennekrouf/ais-runner"
  version "0.1.0"
  # Binaries are distributed from mayorana.ch, not GitHub Releases. The path is
  # the immutable per-tag one, so an old formula revision keeps resolving.
  #
  # NOTE: release.yml does not currently build a macOS .tar.gz — the mac job
  # produces a signed .dmg only. This formula cannot install until that
  # artifact exists; the .dmg is the supported macOS path today.
  url "https://mayorana.ch/downloads/ais-runner/v#{version}/ais-runner-macos-arm64.tar.gz"
  sha256 "REPLACE_WITH_SHA256"

  depends_on arch: :arm64
  depends_on "node"
  depends_on "azure-cli"

  def install
    bin.install "ais-runner"

    # Install npm tools locally — global npm installs are not allowed in Homebrew formulas
    libexec.mkpath
    cd libexec do
      system "npm", "install", "azurite@3.30.0"
      system "npm", "install", "azure-functions-core-tools@4", "--unsafe-perm", "true"
    end

    # Shims so the binaries are on PATH
    %w[azurite azurite-blob azurite-queue azurite-table].each do |cmd|
      (bin/cmd).write_env_script libexec/"node_modules/.bin/#{cmd}", {}
    end
    (bin/"func").write_env_script libexec/"node_modules/.bin/func", {}
  end

  test do
    assert_predicate bin/"ais-runner", :executable?
  end
end
